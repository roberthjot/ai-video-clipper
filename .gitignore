# Environment variables (contains API keys)
.env
.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/

# Frontend (React/Vite)
frontend/node_modules/
frontend/dist/
frontend/.eslintcache
frontend/coverage/

# Application Data
processed_clips*/
projects/
uploads/
cache/

# Video files (too large for git)
*.mp4
*.avi
*.mkv
*.mov
*.wmv
*.webm

# Helper/debug scripts
check_duration.py
check_duration_deep.py
check_models.py
test_*.py

# Temp working files (FFmpeg chunks, ASS subs, thumbnails)
backend/app/services/temp/
backend/app/temp_lyrics/
*.ass

# User-edited prompt overrides (from Ajustes → Prompts)
prompts.json
backend/prompts.json

# Runtime config (contains the editable Gemini API key)
runtime_config.json
backend/runtime_config.json

# Claude Code local config
.claude/

# Windows stray device file
nul
backend/nul

# OS
Thumbs.db
.DS_Store
*.log

# MediaPipe face detection model — auto-downloaded on first use by
# face_track_service.py; not worth committing the binary blob.
_blaze_face.tflite
backend/_blaze_face.tflite
backend/app/services/_blaze_face.tflite

# Scratch scripts
scratch/
